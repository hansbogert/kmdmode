#!/usr/bin/env zsh
# kview [-c COL,...] CMD...: a k9s-style live view of CMD's output. Scroll and filter it in fzf with
# the first line pinned as the header; CMD re-runs $KVIEW_INTERVAL (2) seconds after each refresh,
# and the cursor keeps its place in the list across refreshes. ctrl-r refreshes now. When CMD
# fails (no valid session, say), the header says why in one line, over the last output it gave, and
# it retries less and less often, up to once a minute.
#
# "kubectl get" output is a table: ctrl-z shows only faulty rows (kmdmode faults), Alt-L picks
# which columns to show (-c gives them up front), Alt-S sorts by age, newest first (kubectl's
# --sort-by=.metadata.creationTimestamp, reversed), Enter puts a command for the picked row (e.g.
# "kubectl get -n NS pods NAME") on the next prompt, and Alt-Enter lets you tick the row's labels
# for a get by selector instead (shift-enter can't be told apart from Enter in most terminals).
# In a table of secrets, alt-d shows the picked row's values, decoded, beside it.
# Anything else, like "kubectl describe", is a document: long lines wrap, and Enter puts CMD
# itself on the next prompt; for one secret, alt-d switches to its values, decoded, and back. Either prompt opens in kmdmode, so one key carries on. Esc leaves
# with an empty one, or, when the columns or sort changed, with this view's command updated.
#
# kubectl output is colored through kubecolor when it is installed. Uses the fzf built into kmdmode
# (`kmdmode fzf`), unless KMDMODE_FZF names another, which then needs 0.59+ (--wrap, trigger).
# Runs as `kmdmode kview`, which embeds this script and sets KMDMODE_BIN; run straight from a
# checkout, it uses the checkout's bin/kmdmode.
emulate -L zsh
here=${0:A:h}
bin=${KMDMODE_BIN:-$here/bin/kmdmode}
local -a fzf=("$bin" fzf)
[[ -n $KMDMODE_FZF ]] && fzf=($KMDMODE_FZF)

# kview --decoded RUN ROW: alt-d's preview in a table of secrets: ROW's values, decoded (kmdmode's
# v on the row's get), or why kubectl could not get them.
if [[ $1 == --decoded ]]; then
  run=$2
  local -a cmd=(${(f)"$(<$run/cmd)"})
  line=$($bin pick -- ${(q-)cmd} <<<$3) && line=$($bin apply v -- ${(z)line}) || exit 0
  if ! eval "$line" </dev/null 2>| $run/decoded.err; then
    print -r -- "kview: $($bin why < $run/decoded.err)"
  fi
  exit
fi

# kview --pick-columns RUN: the Alt-L picker, run by fzf from inside a live view. Ticks what is
# shown (or sane defaults), and writes the choice to RUN/columns for the view's filter.
if [[ $1 == --pick-columns ]]; then
  run=$2 current= load=first i=0
  [[ -e $run/columns ]] && current=$(<$run/columns)
  local -a items
  for line in ${(f)"$($bin columns --list "$current" < $run/raw)"}; do
    items+=(${line%%$'\t'*})
    (( ++i ))
    [[ $line == *$'\t'on ]] && load="pos($i)+toggle+$load"
  done
  chosen=$(print -rl -- $items | $fzf --multi --layout=reverse --prompt="columns > " \
    --header="tab: toggle  enter: apply  esc: cancel  (NAMESPACE and NAME always stay)" \
    --bind "load:$load") || exit 0
  local -a picked=(${(f)chosen})
  print -r -- ${(j:,:)${items:*picked}} >| $run/columns  # in table order, not ticking order
  exit
fi

cols=
if [[ $1 == -c ]]; then
  cols=$2
  shift 2
fi
# Alt-S toggles kubectl's age sort live, so the command comes in two versions, without and with.
age=--sort-by=.metadata.creationTimestamp
plain=(${@:#$age})
sorted=
(( ${@[(Ie)$age]} )) && sorted=1
mkcmd() {
  local -a v=("$@")
  [[ $1 == kubectl ]] && (( $+commands[kubecolor] )) && v[1]=kubecolor
  print -r -- "${(j: :)${(@q-)v}}"
}
export KUBECOLOR_FORCE_COLORS=true  # kubecolor writes to fzf, not a terminal
cmd=$(mkcmd $plain) cmd_age=$(mkcmd $plain $age)
interval=${KVIEW_INTERVAL:-2}
if [[ -n $KMDMODE_FZF ]]; then  # the built-in one is new enough; another must be checked
  autoload -Uz is-at-least
  fzf_version=${${(s: :)"$($fzf --version 2>/dev/null)"}[1]}
  if ! is-at-least 0.59 ${fzf_version:-0}; then
    print -u2 "kview: KMDMODE_FZF needs fzf 0.59 or newer (found ${fzf_version:-none}); falling back to watch"
    exec watch -n $interval -- "$(mkcmd "$@") 2>&1"
  fi
fi

run=$(mktemp -d ${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/kview.XXXXXX)
trap 'kill $ticker 2>/dev/null; rm -rf $run' EXIT
# What fzf shows is $run/raw, the last fetch, through $run/filter. Toggles only change the filter's
# state files and reload, so they apply at once instead of on the next fetch.
show="sh $run/filter < $run/raw"
# --exact: rows stay in the command's order (--no-sort), so fuzzy matches, which only ranking
# would push down, would crowd the real ones ("keeper" matching k..e..e..p..e..r across a row).
opts=(--ansi --track --exact --header-lines=1 --layout=reverse --no-sort --info=inline --prompt="$* > ")
local -a layout=(${(f)"$($bin kview-layout -- "$@")"})
if [[ $layout[1] == table ]]; then
  # ctrl-z (as in k9s) shows only faulty rows while $run/faults exists; Alt-L writes the chosen
  # columns to $run/columns; Alt-S shows the newest first while $run/sort exists. Tables are always
  # fetched oldest first (--sort-by creationTimestamp), so Alt-S only reverses the rows, and
  # otherwise they are put back in kubectl's usual namespace/name order: either way at once, from
  # the last fetch, with no new one.
  [[ -n $cols ]] && print -r -- $cols >| $run/columns
  [[ -n $sorted ]] && touch $run/sort
  cat >| $run/filter <<EOF
f=cat; [ -e $run/faults ] && f="$bin faults"
\$f |
if [ -e $run/sort ]; then
  awk 'NR == 1 { print; next } { r[n++] = \$0 } END { while (n) print r[--n] }'
else
  $bin order name
fi |
{ if [ -s $run/columns ]; then $bin columns "\$(cat $run/columns)"; else cat; fi; } |
if [ -e $run/sort ]; then awk 'NR == 1 { print \$0 "  [newest first]"; next } 1'; else cat; fi
EOF
  fetch=$cmd_age
  keys="enter: pick  alt-enter: by labels  alt-l: columns  alt-s: by age  ctrl-z: faults  ctrl-r: refresh  esc: quit"
  if [[ $layout[2] == decode ]]; then
    print -rl -- "$@" >| $run/cmd
    keys="enter: pick  alt-d: decoded  alt-enter: by labels  alt-l: columns  alt-s: by age  ctrl-z: faults  ctrl-r: refresh  esc: quit"
    opts+=(--preview "${(qq)bin} kview --decoded $run {}" --preview-window=hidden,right,50%,wrap
      --bind alt-d:toggle-preview)
  fi
  opts+=(--expect=alt-enter --header=$keys
    --bind "ctrl-z:execute-silent([ -e $run/faults ] && rm -f $run/faults || touch $run/faults)+reload($show)"
    --bind "alt-l:execute(${(q)bin} kview --pick-columns $run)+reload($show)"
    --bind "alt-s:execute-silent([ -e $run/sort ] && rm -f $run/sort || touch $run/sort)+reload($show)")
else
  print -r -- cat >| $run/filter
  fetch=$cmd document=1
  keys="enter: back to the prompt with it  ctrl-r: refresh  esc: quit"
  if [[ $layout[2] == decode ]]; then
    # alt-d fetches the other of v's views, decoded or not, from the next fetch (now) on.
    other=$($bin apply v -- ${(q-)@})
    cmd_other=$(mkcmd ${(Q)${(z)other}})
    keys="enter: back to the prompt with it  alt-d: decode/encode  ctrl-r: refresh  esc: quit"
    opts+=(--bind "alt-d:execute-silent([ -e $run/other ] && rm -f $run/other || touch $run/other; touch $run/now)")
  fi
  opts+=(--wrap --header=$keys)
fi
# Refresh outside fzf: while a reload is running fzf drops cursor keys and holds Enter, so it
# must never wait on kubectl. Likewise no --id-nth: matching the selected row by identity blocks
# keys for a moment after every reload, so an Enter could be lost; --track alone keeps the
# cursor's position instead. This ticker runs the command into $run/raw, then presses f12 over
# fzf's private socket, which reloads from that file in milliseconds. It fetches at once, then
# $interval seconds after each fetch, or sooner when ctrl-r touches $run/now. stdin is /dev/null so
# that a credential helper can't prompt into fzf's terminal; it fails instead, and says why.
post() { curl -s --unix-socket $run/fzf.sock --data-binary "$1" http://localhost >/dev/null }
{
  delay=$interval failed=
  while :; do
    f=$fetch
    [[ -e $run/other ]] && f=$cmd_other
    if eval $f </dev/null >| $run/next 2>| $run/err; then
      mv $run/next $run/raw
      [[ -n $failed ]] && post "change-header:$keys"
      delay=$interval failed=
    else
      # Keep the last good output, unless this one has some; the first must exist for fzf.
      [[ -s $run/next || ! -e $run/raw ]] && mv $run/next $run/raw
      while [[ ! -S $run/fzf.sock ]]; do sleep 0.05; done  # the first fetch can beat fzf
      post "change-header:"$'\e[31m'"kview: $($bin why < $run/err)"$'\e[0m\n'"retrying in $(printf %g $delay)s  $keys"
      failed=1 delay=$(( delay * 2 > 60 ? 60 : delay * 2 ))
    fi
    post 'trigger(f12)'
    for (( t = 0; t < delay * 10; t++ )); do [[ -e $run/now ]] && break; sleep 0.1; done
    rm -f $run/now
  done
} &!
ticker=$!
row=$(FZF_DEFAULT_COMMAND="while [ ! -e $run/raw ]; do sleep 0.1; done; $show" $fzf $opts \
  --listen=$run/fzf.sock --bind "f12:reload($show)" --bind "ctrl-r:execute-silent(touch $run/now)")
rc=$?
if (( rc == 130 )); then  # Esc is the normal way out, not a failure
  chosen= sort_now=
  [[ -e $run/columns ]] && chosen=$(<$run/columns)
  [[ -e $run/sort ]] && sort_now=1
  [[ $chosen == "$cols" && $sort_now == "$sorted" ]] && exit 0
  final=($plain)
  [[ -n $sort_now ]] && final+=($age)
  line="kview ${chosen:+-c ${(q-)chosen} }${(j: :)${(@q-)final}}"
elif (( rc )); then
  exit $rc
elif [[ -e $run/other ]]; then  # Enter on a document gives the command it shows
  line=$other
elif [[ -n $document ]]; then
  line=${(j: :)${(@q-)@}}
else
  # --expect puts the key that ended fzf (empty for Enter) on the line before the row.
  key=${row%%$'\n'*} row=${row#*$'\n'}
  line=$($bin pick -- ${(q-)@} <<<$row) || line=$row
  if [[ $key == alt-enter ]]; then
    # Alt-Enter: tick some of the row's labels, and get everything of its type carrying them.
    get=(${(Q)${(z)line}})
    labels=$("${get[@]}" -o 'go-template={{range $k, $v := .metadata.labels}}{{$k}}={{$v}}{{"\n"}}{{end}}' 2>&1 |
      $fzf --multi --layout=reverse --prompt="labels of ${get[-1]} > " \
        --header="tab: select  enter: done  esc: cancel") || exit 0
    line=$($bin select -- ${(q-)@} <<<"$row"$'\n'"$labels") || exit 1
  fi
fi
# The plugin's precmd hook puts what lands in $KMDMODE_PICK_FILE on the next prompt; without the
# plugin, print it instead.
if [[ -n $KMDMODE_PICK_FILE ]]; then
  print -r -- $line >| $KMDMODE_PICK_FILE
else
  print -r -- $line
fi
