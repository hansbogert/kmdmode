#!/usr/bin/env zsh
# kview [-c COL,...] CMD...: a k9s-style live view of CMD's output. Scroll and filter it in fzf with
# the first line pinned as the header; CMD re-runs $KVIEW_INTERVAL (2) seconds after each refresh,
# and the cursor keeps its place in the list across refreshes. ctrl-r refreshes now.
#
# "kubectl get" output is a table: ctrl-z shows only faulty rows (cmdmode faults), Alt-L picks
# which columns to show (-c gives them up front), Alt-S sorts by age, newest first (kubectl's
# --sort-by=.metadata.creationTimestamp, reversed), Enter puts a command for the picked row (e.g.
# "kubectl get -n NS pods NAME") on the next prompt, and Alt-Enter lets you tick the row's labels
# for a get by selector instead (shift-enter can't be told apart from Enter in most terminals).
# Anything else, like "kubectl describe", is a document: long lines wrap, and Enter puts CMD
# itself on the next prompt. Either prompt opens in cmdmode, so one key carries on. Esc leaves
# with an empty one, or, when the columns or sort changed, with this view's command updated.
#
# kubectl output is colored through kubecolor when it is installed. Needs fzf 0.59+ (--wrap,
# trigger), else falls back to watch. Runs as `cmdmode kview`, which embeds this script and sets
# CMDMODE_BIN (and CMDMODE_FZF when an fzf sits next to the binary); run straight from a checkout,
# it uses the checkout's bin/.
emulate -L zsh
here=${0:A:h}
bin=${CMDMODE_BIN:-$here/bin/cmdmode}
fzf=$CMDMODE_FZF
if [[ -z $fzf ]]; then
  if [[ -z $CMDMODE_BIN && -x $here/bin/fzf ]]; then
    fzf=$here/bin/fzf  # a checkout's own, from make
  elif (( $+commands[fzf] )); then
    fzf=fzf
  fi
fi

# kview --pick-columns RUN: the Alt-L picker, run by fzf from inside a live view. Ticks what is
# shown (or sane defaults), and writes the choice to RUN/columns for the view's filter.
if [[ $1 == --pick-columns ]]; then
  run=$2 current= load=first i=0
  [[ -e $run/columns ]] && current=$(<$run/columns)
  local -a items
  for line in ${(f)"$($bin columns --list "$current" < $run/raw)"}; do
    items+=(${line%%$'\t'*})
    (( ++i ))
    [[ $line == *$'\t'on ]] && load="pos($i)+toggle+$load"
  done
  chosen=$(print -rl -- $items | $fzf --multi --layout=reverse --prompt="columns > " \
    --header="tab: toggle  enter: apply  esc: cancel  (NAMESPACE and NAME always stay)" \
    --bind "load:$load") || exit 0
  local -a picked=(${(f)chosen})
  print -r -- ${(j:,:)${items:*picked}} >| $run/columns  # in table order, not ticking order
  exit
fi

cols=
if [[ $1 == -c ]]; then
  cols=$2
  shift 2
fi
# Alt-S toggles kubectl's age sort live, so the command comes in two versions, without and with.
age=--sort-by=.metadata.creationTimestamp
plain=(${@:#$age})
sorted=
(( ${@[(Ie)$age]} )) && sorted=1
mkcmd() {
  local -a v=("$@")
  [[ $1 == kubectl ]] && (( $+commands[kubecolor] )) && v[1]=kubecolor
  print -r -- "${(j: :)${(@q-)v}} 2>&1"
}
export KUBECOLOR_FORCE_COLORS=true  # kubecolor writes to fzf, not a terminal
cmd=$(mkcmd $plain) cmd_age=$(mkcmd $plain $age)
interval=${KVIEW_INTERVAL:-2}
autoload -Uz is-at-least
fzf_version=${${(s: :)"$($fzf --version 2>/dev/null)"}[1]}
if [[ -z $fzf ]] || ! is-at-least 0.59 ${fzf_version:-0}; then
  print -u2 "kview: needs fzf 0.59 or newer (found ${fzf_version:-none}); falling back to watch"
  exec watch -n $interval -- $(mkcmd "$@")
fi

run=$(mktemp -d ${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/kview.XXXXXX)
trap 'kill $ticker 2>/dev/null; rm -rf $run' EXIT
# What fzf shows is $run/raw, the last fetch, through $run/filter. Toggles only change the filter's
# state files and reload, so they apply at once instead of on the next fetch.
show="sh $run/filter < $run/raw"
opts=(--ansi --track --header-lines=1 --layout=reverse --no-sort --info=inline --prompt="$* > ")
if [[ $1 == kubectl && ${@[(I)get]} -gt 0 ]]; then
  # ctrl-z (as in k9s) shows only faulty rows while $run/faults exists; Alt-L writes the chosen
  # columns to $run/columns; Alt-S sorts by age while $run/sort exists, newest first: kubectl
  # sorts oldest first, so the rows of a fetch made sorted ($run/sorted) are reversed.
  [[ -n $cols ]] && print -r -- $cols >| $run/columns
  [[ -n $sorted ]] && touch $run/sort
  cat >| $run/filter <<EOF
f=cat; [ -e $run/faults ] && f="$bin faults"
{ if [ -s $run/columns ]; then \$f | $bin columns "\$(cat $run/columns)"; else \$f; fi; } |
if [ -e $run/sorted ]; then
  awk 'NR == 1 { print \$0 "  [newest first]"; next } { r[n++] = \$0 } END { while (n) print r[--n] }'
else
  cat
fi
EOF
  opts+=(--expect=alt-enter
    --header="enter: pick  alt-enter: by labels  alt-l: columns  alt-s: by age  ctrl-z: faults  ctrl-r: refresh  esc: quit"
    --bind "ctrl-z:execute-silent([ -e $run/faults ] && rm -f $run/faults || touch $run/faults)+reload($show)"
    --bind "alt-l:execute(${(q)bin} kview --pick-columns $run)+reload($show)"
    --bind "alt-s:execute-silent([ -e $run/sort ] && rm -f $run/sort || touch $run/sort; touch $run/now)")
else
  print -r -- cat >| $run/filter
  document=1
  opts+=(--wrap --header="enter: back to the prompt with it  ctrl-r: refresh  esc: quit")
fi
# Refresh outside fzf: while a reload is running fzf drops cursor keys and holds Enter, so it
# must never wait on kubectl. Likewise no --id-nth: matching the selected row by identity blocks
# keys for a moment after every reload, so an Enter could be lost; --track alone keeps the
# cursor's position instead. This ticker runs the command into $run/raw, then presses f12 over
# fzf's private socket, which reloads from that file in milliseconds. It fetches at once, then
# $interval seconds after each fetch, or sooner when ctrl-r or Alt-S touch $run/now.
{
  while :; do
    if [[ -e $run/sort ]]; then
      eval $cmd_age >| $run/next && mv $run/next $run/raw && touch $run/sorted
    else
      eval $cmd >| $run/next && mv $run/next $run/raw && rm -f $run/sorted
    fi
    curl -s --unix-socket $run/fzf.sock -d 'trigger(f12)' http://localhost >/dev/null
    for (( t = 0; t < interval * 10; t++ )); do [[ -e $run/now ]] && break; sleep 0.1; done
    rm -f $run/now
  done
} &!
ticker=$!
row=$(FZF_DEFAULT_COMMAND="while [ ! -e $run/raw ]; do sleep 0.1; done; $show" $fzf $opts \
  --listen=$run/fzf.sock --bind "f12:reload($show)" --bind "ctrl-r:execute-silent(touch $run/now)")
rc=$?
if (( rc == 130 )); then  # Esc is the normal way out, not a failure
  chosen= sort_now=
  [[ -e $run/columns ]] && chosen=$(<$run/columns)
  [[ -e $run/sort ]] && sort_now=1
  [[ $chosen == "$cols" && $sort_now == "$sorted" ]] && exit 0
  final=($plain)
  [[ -n $sort_now ]] && final+=($age)
  line="kview ${chosen:+-c ${(q-)chosen} }${(j: :)${(@q-)final}}"
elif (( rc )); then
  exit $rc
elif [[ -n $document ]]; then
  line=${(j: :)${(@q-)@}}
else
  # --expect puts the key that ended fzf (empty for Enter) on the line before the row.
  key=${row%%$'\n'*} row=${row#*$'\n'}
  line=$($bin pick -- ${(q-)@} <<<$row) || line=$row
  if [[ $key == alt-enter ]]; then
    # Alt-Enter: tick some of the row's labels, and get everything of its type carrying them.
    get=(${(Q)${(z)line}})
    labels=$("${get[@]}" -o 'go-template={{range $k, $v := .metadata.labels}}{{$k}}={{$v}}{{"\n"}}{{end}}' 2>&1 |
      $fzf --multi --layout=reverse --prompt="labels of ${get[-1]} > " \
        --header="tab: select  enter: done  esc: cancel") || exit 0
    line=$($bin select -- ${(q-)@} <<<"$row"$'\n'"$labels") || exit 1
  fi
fi
# The plugin's precmd hook puts what lands in $CMDMODE_PICK_FILE on the next prompt; without the
# plugin, print it instead.
if [[ -n $CMDMODE_PICK_FILE ]]; then
  print -r -- $line >| $CMDMODE_PICK_FILE
else
  print -r -- $line
fi
